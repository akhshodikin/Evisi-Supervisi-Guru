{
  "firestore": {
    "databaseId": "ai-studio-supervisiguru-f0604e1c-beaa-478b-afb7-5d387c46c087",
    "rules": "firestore.rules",
    "edition": "ENTERPRISE",
    "dataAccessMode": "FIRESTORE_NATIVE"
